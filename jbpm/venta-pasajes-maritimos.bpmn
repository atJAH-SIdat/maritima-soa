    <bpmn2:sequenceFlow id="f11" sourceRef="G3" targetRef="Gm" name="Nacional"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Nacional]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return !"INTERNACIONAL".equals(kcontext.getVariable("tipoRuta"));]]></bpmn2:conditionExpression></bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="f12" sourceRef="G3" targetRef="T4" name="Internacional"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Internacional]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "INTERNACIONAL".equals(kcontext.getVariable("tipoRuta"));]]></bpmn2:conditionExpression></bpmn2:sequenceFlow>
