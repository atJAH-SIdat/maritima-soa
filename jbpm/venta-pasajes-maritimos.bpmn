    <bpmn2:exclusiveGateway id="G3" name="¿Tipo de ruta?" gatewayDirection="Diverging"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[¿Tipo de ruta?]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>f10</bpmn2:incoming><bpmn2:outgoing>f11</bpmn2:outgoing><bpmn2:outgoing>f12</bpmn2:outgoing></bpmn2:exclusiveGateway>
    <bpmn2:scriptTask id="T4" name="Validar migración del pasajero [SOAP]" scriptFormat="http://www.java.com/java"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Validar migración del pasajero [SOAP]]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>f12</bpmn2:incoming><bpmn2:outgoing>f13</bpmn2:outgoing><bpmn2:script><![CDATA[// Valida el pasaporte en Migraciones (SOAP :8083), solo rutas internacionales
String url = "http://localhost:8083/ws";
try {
  String xml = "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:aut=\"http://maritimasoa.grupo4.pe/autoridadportuaria\"><soapenv:Body>" + "<aut:validarMigracionPasajeroRequest><aut:numeroPasaporte>" + kcontext.getVariable("numeroPasaporte") + "</aut:numeroPasaporte><aut:documentoIdentidad>" + kcontext.getVariable("documentoPasajero") + "</aut:documentoIdentidad><aut:paisDestino>" + kcontext.getVariable("paisDestino") + "</aut:paisDestino></aut:validarMigracionPasajeroRequest>" + "</soapenv:Body></soapenv:Envelope>";
  java.net.HttpURLConnection con = (java.net.HttpURLConnection) new java.net.URL(url).openConnection();
  con.setRequestMethod("POST");
  con.setDoOutput(true);
  con.setRequestProperty("Content-Type", "text/xml; charset=UTF-8");
  java.io.OutputStream out = con.getOutputStream();
  out.write(xml.getBytes("UTF-8"));
  out.close();

  int code = con.getResponseCode();
  java.io.InputStream in = code < 400 ? con.getInputStream() : con.getErrorStream();
  String body = "";
  if (in != null) {
    java.util.Scanner sc = new java.util.Scanner(in, "UTF-8").useDelimiter("\\A");
    body = sc.hasNext() ? sc.next() : "";
    sc.close();
  }
  System.out.println("[MaritimaSOA] SOAP validarMigracionPasajero -> " + code);
  java.util.regex.Matcher mH = java.util.regex.Pattern.compile("<(?:\\w+:)?habilitadoViaje>([^<]*)<").matcher(body);
  java.util.regex.Matcher mM = java.util.regex.Pattern.compile("<(?:\\w+:)?mensajeControl>([^<]*)<").matcher(body);
  boolean habilitado = mH.find() && "true".equals(mH.group(1).trim());
  kcontext.setVariable("habilitadoViaje", Boolean.valueOf(habilitado));
  if (!habilitado) {
    kcontext.setVariable("motivoRechazo", "MIGRACION_RECHAZADA: " + (mM.find() ? mM.group(1) : "sin respuesta"));
  }
} catch (java.io.IOException e) {
  throw new RuntimeException("El servicio SOAP no responde (" + url + ")", e);
}
]]></bpmn2:script></bpmn2:scriptTask>
    <bpmn2:exclusiveGateway id="G4" name="¿Habilitado para viajar?" gatewayDirection="Diverging"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[¿Habilitado para viajar?]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>f13</bpmn2:incoming><bpmn2:outgoing>f14</bpmn2:outgoing><bpmn2:outgoing>f15</bpmn2:outgoing></bpmn2:exclusiveGateway>
