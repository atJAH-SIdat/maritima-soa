    <bpmn2:sequenceFlow id="f6" sourceRef="G1" targetRef="Gr" name="No"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[No]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[Integer c = (Integer) kcontext.getVariable("cuposDisponibles");
