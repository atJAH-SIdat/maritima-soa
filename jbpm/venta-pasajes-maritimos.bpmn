    <bpmn2:scriptTask id="T9" name="Notificar rechazo al pasajero" scriptFormat="http://www.java.com/java"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Notificar rechazo al pasajero]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>f8</bpmn2:incoming><bpmn2:outgoing>f9</bpmn2:outgoing><bpmn2:script><![CDATA[// Rechazo por falta de cupos o puerto cerrado
