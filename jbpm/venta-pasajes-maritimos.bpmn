    <bpmn2:scriptTask id="T10" name="Notificar rechazo migratorio" scriptFormat="http://www.java.com/java"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Notificar rechazo migratorio]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>f15</bpmn2:incoming><bpmn2:outgoing>f16</bpmn2:outgoing><bpmn2:script><![CDATA[// Rechazo por control migratorio
kcontext.setVariable("estado", "RECHAZADA");
System.out.println("[MaritimaSOA] Venta RECHAZADA: " + kcontext.getVariable("motivoRechazo"));
]]></bpmn2:script></bpmn2:scriptTask>
    <bpmn2:endEvent id="End3" name="Venta rechazada (control migratorio)"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Venta rechazada (control migratorio)]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>f16</bpmn2:incoming></bpmn2:endEvent>
    <bpmn2:scriptTask id="T5" name="Emitir boleto y descontar cupos [REST]" scriptFormat="http://www.java.com/java"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Emitir boleto y descontar cupos [REST]]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>f17</bpmn2:incoming><bpmn2:outgoing>f18</bpmn2:outgoing><bpmn2:script><![CDATA[// Emite el boleto en NavieraReservasAPI (REST :8082) y descuenta los cupos
String url = "http://localhost:8082/api/boletos";
try {
  String nombre = String.valueOf(kcontext.getVariable("nombrePasajero")).replace("\"", "'");
  String json = "{\"codigoViaje\":\"" + kcontext.getVariable("codigoViaje") + "\","
      + "\"documentoPasajero\":\"" + kcontext.getVariable("documentoPasajero") + "\","
      + "\"nombrePasajero\":\"" + nombre + "\","
      + "\"tipoRuta\":\"" + kcontext.getVariable("tipoRuta") + "\","
      + "\"cantidadAsientos\":" + kcontext.getVariable("cantidadAsientos") + ","
      + "\"codigoAutorizacionZarpe\":\"" + kcontext.getVariable("codigoAutorizacionZarpe") + "\"}";
  java.net.HttpURLConnection con = (java.net.HttpURLConnection) new java.net.URL(url).openConnection();
  con.setRequestMethod("POST");
  con.setDoOutput(true);
  con.setRequestProperty("Content-Type", "application/json; charset=UTF-8");
  java.io.OutputStream out = con.getOutputStream();
  out.write(json.getBytes("UTF-8"));
  out.close();

  int code = con.getResponseCode();
  java.io.InputStream in = code < 400 ? con.getInputStream() : con.getErrorStream();
  String body = "";
  if (in != null) {
    java.util.Scanner sc = new java.util.Scanner(in, "UTF-8").useDelimiter("\\A");
    body = sc.hasNext() ? sc.next() : "";
    sc.close();
  }
  System.out.println("[MaritimaSOA] POST " + url + " -> " + code + " " + body);
  if (code != 201) {
    throw new RuntimeException("No se pudo emitir el boleto: " + body);
  }
  java.util.regex.Matcher mI = java.util.regex.Pattern.compile("\"idBoleto\"\\s*:\\s*\"([^\"]*)\"").matcher(body);
  java.util.regex.Matcher mT = java.util.regex.Pattern.compile("\"montoTotal\"\\s*:\\s*(-?[0-9.]+)").matcher(body);
  java.util.regex.Matcher mU = java.util.regex.Pattern.compile("\"muelleEmbarque\"\\s*:\\s*\"([^\"]*)\"").matcher(body);
  if (mI.find()) kcontext.setVariable("idBoleto", mI.group(1));
  if (mT.find()) kcontext.setVariable("montoTotal", mT.group(1));
  if (mU.find()) kcontext.setVariable("muelleEmbarque", mU.group(1));
  kcontext.setVariable("estado", "EMITIDO");
} catch (java.io.IOException e) {
  throw new RuntimeException("El servicio REST no responde (" + url + ")", e);
}
]]></bpmn2:script></bpmn2:scriptTask>
    <bpmn2:scriptTask id="T6" name="Publicar aviso de embarque [ActiveMQ]" scriptFormat="http://www.java.com/java"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Publicar aviso de embarque [ActiveMQ]]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>f18</bpmn2:incoming><bpmn2:outgoing>f19</bpmn2:outgoing><bpmn2:script><![CDATA[// Publica el aviso de embarque en ActiveMQ (cola.embarque.boletos) por STOMP, puerto 61613
String mensaje = "{\"idBoleto\":\"" + kcontext.getVariable("idBoleto") + "\",\"codigoViaje\":\""
    + kcontext.getVariable("codigoViaje") + "\",\"muelleEmbarque\":\"" + kcontext.getVariable("muelleEmbarque") + "\"}";
java.net.Socket socket = new java.net.Socket();
try {
  socket.connect(new java.net.InetSocketAddress("localhost", 61613), 3000);
  socket.setSoTimeout(5000);
  java.io.OutputStream out = socket.getOutputStream();
  java.io.InputStream in = socket.getInputStream();
  String[] tramas = {
    "CONNECT\naccept-version:1.2\nhost:localhost\nlogin:admin\npasscode:admin\n\n",
    "SEND\ndestination:/queue/cola.embarque.boletos\ncontent-type:application/json\nreceipt:aviso\n\n" + mensaje
  };
  String[] esperado = { "CONNECTED", "RECEIPT" };
  for (int i = 0; i < tramas.length; i++) {
    out.write(tramas[i].getBytes("UTF-8"));
    out.write(0);
    out.flush();
    StringBuilder resp = new StringBuilder();
    int b;
    while ((b = in.read()) > 0) resp.append((char) b);
    String r = resp.toString().trim();
    if (!r.startsWith(esperado[i])) throw new java.io.IOException("ActiveMQ respondió: " + r);
  }
  out.write("DISCONNECT\n\n".getBytes("UTF-8"));
  out.write(0);
  out.flush();
  System.out.println("[MaritimaSOA] ActiveMQ cola.embarque.boletos <- " + mensaje);
  kcontext.setVariable("avisoEmbarque", "PUBLICADO");
} catch (java.io.IOException e) {
  System.out.println("[MaritimaSOA] ActiveMQ no disponible: " + e.getMessage());
  kcontext.setVariable("avisoEmbarque", "NO_PUBLICADO (" + e.getMessage() + ")");
} finally {
  try { socket.close(); } catch (java.io.IOException ignorada) { }
}
]]></bpmn2:script></bpmn2:scriptTask>
    <bpmn2:scriptTask id="T7" name="Generar pase de embarque" scriptFormat="http://www.java.com/java"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Generar pase de embarque]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>f19</bpmn2:incoming><bpmn2:outgoing>f20</bpmn2:outgoing><bpmn2:script><![CDATA[// Despacho genera el pase de embarque a partir del boleto
kcontext.setVariable("paseEmbarque", "PASE-" + kcontext.getVariable("idBoleto"));
System.out.println("[MaritimaSOA] Pase de embarque " + kcontext.getVariable("paseEmbarque"));
]]></bpmn2:script></bpmn2:scriptTask>
