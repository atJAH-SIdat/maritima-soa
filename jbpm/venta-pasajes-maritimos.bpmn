    <bpmn2:scriptTask id="T2" name="Consultar viaje y cupos [REST]" scriptFormat="http://www.java.com/java"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Consultar viaje y cupos [REST]]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>f2</bpmn2:incoming><bpmn2:outgoing>f3</bpmn2:outgoing><bpmn2:script><![CDATA[// Consulta el viaje en NavieraReservasAPI (REST :8082)
String url = "http://localhost:8082/api/viajes/" + kcontext.getVariable("codigoViaje");
try {
  java.net.HttpURLConnection con = (java.net.HttpURLConnection) new java.net.URL(url).openConnection();
  con.setRequestMethod("GET");

  int code = con.getResponseCode();
  java.io.InputStream in = code < 400 ? con.getInputStream() : con.getErrorStream();
  String body = "";
  if (in != null) {
    java.util.Scanner sc = new java.util.Scanner(in, "UTF-8").useDelimiter("\\A");
    body = sc.hasNext() ? sc.next() : "";
    sc.close();
  }
  System.out.println("[MaritimaSOA] GET " + url + " -> " + code);
  if (code == 200) {
    java.util.regex.Matcher mT = java.util.regex.Pattern.compile("\"tipoRuta\"\\s*:\\s*\"([^\"]*)\"").matcher(body);
    java.util.regex.Matcher mP = java.util.regex.Pattern.compile("\"codigoPuerto\"\\s*:\\s*\"([^\"]*)\"").matcher(body);
    java.util.regex.Matcher mF = java.util.regex.Pattern.compile("\"fechaZarpe\"\\s*:\\s*\"([^\"]*)\"").matcher(body);
    java.util.regex.Matcher mD = java.util.regex.Pattern.compile("\"paisDestino\"\\s*:\\s*\"([^\"]*)\"").matcher(body);
    java.util.regex.Matcher mC = java.util.regex.Pattern.compile("\"cuposDisponibles\"\\s*:\\s*(-?[0-9.]+)").matcher(body);
    if (mT.find()) kcontext.setVariable("tipoRuta", mT.group(1));
    if (mP.find()) kcontext.setVariable("codigoPuerto", mP.group(1));
    if (mF.find()) kcontext.setVariable("fechaZarpe", mF.group(1));
    if (mD.find()) kcontext.setVariable("paisDestino", mD.group(1));
    Integer cupos = mC.find() ? Integer.valueOf(mC.group(1)) : Integer.valueOf(0);
    kcontext.setVariable("cuposDisponibles", cupos);
    Integer pedidos = (Integer) kcontext.getVariable("cantidadAsientos");
    if (pedidos == null || cupos.intValue() < pedidos.intValue()) {
      kcontext.setVariable("motivoRechazo", "SIN_CUPOS: el viaje tiene " + cupos + " cupos");
    }
  } else {
    kcontext.setVariable("cuposDisponibles", Integer.valueOf(0));
    kcontext.setVariable("motivoRechazo", "Viaje no disponible: " + body);
  }
} catch (java.io.IOException e) {
  throw new RuntimeException("El servicio REST no responde (" + url + ")", e);
}
]]></bpmn2:script></bpmn2:scriptTask>
    <bpmn2:exclusiveGateway id="G1" name="¿Hay cupos?" gatewayDirection="Diverging"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[¿Hay cupos?]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>f3</bpmn2:incoming><bpmn2:outgoing>f4</bpmn2:outgoing><bpmn2:outgoing>f6</bpmn2:outgoing></bpmn2:exclusiveGateway>
    <bpmn2:scriptTask id="T3" name="Consultar estado del puerto [SOAP]" scriptFormat="http://www.java.com/java"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Consultar estado del puerto [SOAP]]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>f4</bpmn2:incoming><bpmn2:outgoing>f5</bpmn2:outgoing><bpmn2:script><![CDATA[// Consulta el estado del puerto en AutoridadPortuariaService (SOAP :8083)
String url = "http://localhost:8083/ws";
try {
  String xml = "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:aut=\"http://maritimasoa.grupo4.pe/autoridadportuaria\"><soapenv:Body>" + "<aut:consultarEstadoPuertoRequest><aut:codigoPuerto>" + kcontext.getVariable("codigoPuerto") + "</aut:codigoPuerto><aut:fechaZarpe>" + kcontext.getVariable("fechaZarpe") + "</aut:fechaZarpe></aut:consultarEstadoPuertoRequest>" + "</soapenv:Body></soapenv:Envelope>";
  java.net.HttpURLConnection con = (java.net.HttpURLConnection) new java.net.URL(url).openConnection();
  con.setRequestMethod("POST");
  con.setDoOutput(true);
  con.setRequestProperty("Content-Type", "text/xml; charset=UTF-8");
  java.io.OutputStream out = con.getOutputStream();
  out.write(xml.getBytes("UTF-8"));
  out.close();

  int code = con.getResponseCode();
  java.io.InputStream in = code < 400 ? con.getInputStream() : con.getErrorStream();
  String body = "";
  if (in != null) {
    java.util.Scanner sc = new java.util.Scanner(in, "UTF-8").useDelimiter("\\A");
    body = sc.hasNext() ? sc.next() : "";
    sc.close();
  }
  System.out.println("[MaritimaSOA] SOAP consultarEstadoPuerto -> " + code);
  java.util.regex.Matcher mA = java.util.regex.Pattern.compile("<(?:\\w+:)?puertoAbierto>([^<]*)<").matcher(body);
  java.util.regex.Matcher mC = java.util.regex.Pattern.compile("<(?:\\w+:)?condicionMaritima>([^<]*)<").matcher(body);
  java.util.regex.Matcher mZ = java.util.regex.Pattern.compile("<(?:\\w+:)?codigoAutorizacionZarpe>([^<]*)<").matcher(body);
  boolean abierto = mA.find() && "true".equals(mA.group(1).trim());
  kcontext.setVariable("puertoAbierto", Boolean.valueOf(abierto));
  if (mZ.find()) kcontext.setVariable("codigoAutorizacionZarpe", mZ.group(1));
  if (!abierto) {
    kcontext.setVariable("motivoRechazo", "PUERTO_CERRADO: " + (mC.find() ? mC.group(1) : "sin respuesta"));
  }
} catch (java.io.IOException e) {
  throw new RuntimeException("El servicio SOAP no responde (" + url + ")", e);
}
]]></bpmn2:script></bpmn2:scriptTask>
    <bpmn2:exclusiveGateway id="G2" name="¿Puerto abierto?" gatewayDirection="Diverging"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[¿Puerto abierto?]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>f5</bpmn2:incoming><bpmn2:outgoing>f7</bpmn2:outgoing><bpmn2:outgoing>f10</bpmn2:outgoing></bpmn2:exclusiveGateway>
