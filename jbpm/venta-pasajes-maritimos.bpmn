    <bpmn2:sequenceFlow id="f4" sourceRef="G1" targetRef="T3" name="Sí"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Sí]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[Integer c = (Integer) kcontext.getVariable("cuposDisponibles");
