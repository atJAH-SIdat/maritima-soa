{
  "info": {
    "name": "MaritimaSOA - Mule ESB (venta-pasajes-flow)",
    "description": "Pruebas de punta a punta del flujo Mule (Grupo 4). Requiere ActiveMQ, el servicio REST, el servicio SOAP y la aplicación Mule encendidos. Reiniciar el servicio REST antes de ejecutar para tener los cupos iniciales. Para probar la excepción técnica (503), apagar el servicio SOAP y enviar la petición 2.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Venta internacional exitosa (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201', () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.test('Estado EMITIDO', () => pm.expect(b.estado).to.eql('EMITIDO'));",
              "pm.test('Monto = 2 x 180', () => pm.expect(b.montoTotal).to.eql(360));",
              "pm.test('Aviso publicado en ActiveMQ', () => pm.expect(b.avisoEmbarque).to.eql('PUBLICADO'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigoViaje\": \"MAR-INT-01\",\n  \"cantidadAsientos\": 2,\n  \"documentoPasajero\": \"71234567\",\n  \"nombrePasajero\": \"Ana Perez\",\n  \"numeroPasaporte\": \"PE1234567\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{muleUrl}}/api/ventas"
      }
    },
