<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_MaritimaSOA" targetNamespace="http://maritimasoa.grupo4/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="MaritimaSOA: venta de pasajes marítimos" processRef="VentaPasajesMaritimos"/>
  </bpmn:collaboration>
  <bpmn:process id="VentaPasajesMaritimos" name="Venta de pasajes marítimos" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Pasajero" name="Pasajero">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Naviera" name="Naviera: plataforma de venta (jBPM + servicio REST)">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Autoridad" name="Autoridad Portuaria y Migraciones (SOAP)">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Despacho" name="Despacho de embarque (ActiveMQ)">
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Solicitud de pasaje">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Solicitar reserva de pasaje">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T2" name="Consultar viaje y cupos [REST]">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="¿Hay cupos?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T3" name="Consultar estado del puerto [SOAP]">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2" name="¿Puerto abierto?">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gr">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T9" name="Notificar rechazo al pasajero">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End2" name="Venta rechazada (sin cupos o puerto cerrado)">
      <bpmn:incoming>f9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G3" name="¿Tipo de ruta?">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T4" name="Validar migración del pasajero [SOAP]">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G4" name="¿Habilitado para viajar?">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gm">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T10" name="Notificar rechazo migratorio">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End3" name="Venta rechazada (control migratorio)">
      <bpmn:incoming>f16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T5" name="Emitir boleto y descontar cupos [REST]">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T6" name="Publicar aviso de embarque [JMS]">
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="T7" name="Generar pase de embarque [JMS]">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="T8" name="Recibir boleto y pase de embarque">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End1" name="Venta exitosa">
      <bpmn:incoming>f21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="T1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="T1" targetRef="T2"/>
    <bpmn:sequenceFlow id="f3" sourceRef="T2" targetRef="G1"/>
    <bpmn:sequenceFlow id="f4" name="Sí" sourceRef="G1" targetRef="T3"/>
    <bpmn:sequenceFlow id="f5" sourceRef="T3" targetRef="G2"/>
    <bpmn:sequenceFlow id="f6" name="No" sourceRef="G1" targetRef="Gr"/>
    <bpmn:sequenceFlow id="f7" name="No" sourceRef="G2" targetRef="Gr"/>
    <bpmn:sequenceFlow id="f8" sourceRef="Gr" targetRef="T9"/>
    <bpmn:sequenceFlow id="f9" sourceRef="T9" targetRef="End2"/>
    <bpmn:sequenceFlow id="f10" name="Sí" sourceRef="G2" targetRef="G3"/>
    <bpmn:sequenceFlow id="f11" name="Nacional" sourceRef="G3" targetRef="Gm"/>
    <bpmn:sequenceFlow id="f12" name="Internacional" sourceRef="G3" targetRef="T4"/>
    <bpmn:sequenceFlow id="f13" sourceRef="T4" targetRef="G4"/>
    <bpmn:sequenceFlow id="f14" name="Sí" sourceRef="G4" targetRef="Gm"/>
    <bpmn:sequenceFlow id="f15" name="No" sourceRef="G4" targetRef="T10"/>
    <bpmn:sequenceFlow id="f16" sourceRef="T10" targetRef="End3"/>
    <bpmn:sequenceFlow id="f17" sourceRef="Gm" targetRef="T5"/>
    <bpmn:sequenceFlow id="f18" sourceRef="T5" targetRef="T6"/>
    <bpmn:sequenceFlow id="f19" sourceRef="T6" targetRef="T7"/>
    <bpmn:sequenceFlow id="f20" sourceRef="T7" targetRef="T8"/>
    <bpmn:sequenceFlow id="f21" sourceRef="T8" targetRef="End1"/>
  </bpmn:process>
